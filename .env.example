# HalluScope Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Model Configuration
MODEL_NAME=meta-llama/Llama-2-7b-hf
MODEL_CACHE_DIR=~/.cache/huggingface
DEVICE=cuda  # cuda, cpu, or auto

# HuggingFace Configuration
HF_TOKEN=your_huggingface_token_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/halluscope.log

# Risk Thresholds
HRI_LOW_THRESHOLD=0.3
HRI_HIGH_THRESHOLD=0.7

# Database (if needed)
# DATABASE_URL=sqlite:///./halluscope.db
