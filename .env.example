# HalluScope environment variables.
# Copy this file to .env (also at the repo root) and fill in the values.
# .env is git-ignored; .env.example is committed.

# ── Required ────────────────────────────────────────────────────────
# OpenAI API key for the API-mode adapter (gpt-4o-mini chat completions
# with logprobs=True, top_logprobs=5). Get one from
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Optional ────────────────────────────────────────────────────────
# Override the local-mode HuggingFace model. Default is TinyLlama-1.1B-Chat;
# any AutoModelForCausalLM-compatible repo id works (e.g. Qwen/Qwen2.5-3B-Instruct).
# LOCAL_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
