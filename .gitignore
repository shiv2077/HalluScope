# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Python packaging build artifacts (e.g. packages/halluscope-core)
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
backend/.venv/

# Environment files
.env
.env.*
!.env.example

# Frontend dependencies and build outputs
frontend/node_modules/
frontend/dist/

# Vite cache
frontend/node_modules/.vite/

# SQLite databases
*.db
halluscope.db

# OS/Editor
.DS_Store
Thumbs.db
.vscode/

# HalluScope-v2 (hv2) — runtime artifacts, never commit (regenerable via scripts/)
gpu.lock
logs/
data/cache/
data/*.parquet
data/*.h5
data/*.jsonl
data/*.json
!data/*_questions.csv
!data/human_sample_*.json
results/*
!results/calibration.json
!results/calls.jsonl
!results/gates_test.md
!results/gates_test.json
!results/phase1_notes.md
!results/evaluation.json
!results/human_agreement.md
!results/ptrue_variants.json
*.h5
# itemtriage: track derived tables, splits, results and call log; keep raw downloads and caches local
data/itemtriage/raw/
data/itemtriage/cache/
!results/itemtriage/
results/itemtriage/*
!results/itemtriage/*.json
!results/itemtriage/calls.jsonl

# Local agent instructions, never tracked
CLAUDE.md
AGENTS.md
